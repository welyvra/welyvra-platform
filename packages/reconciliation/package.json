{
  "name": "@welyvra/reconciliation",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@welyvra/source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "welyvra-reconcile": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "reconcile": "node dist/cli.js"
  },
  "dependencies": {
    "@welyvra/core": "workspace:*",
    "@welyvra/db": "workspace:*",
    "postgres": "3.4.8"
  }
}
