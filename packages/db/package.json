{
  "name": "@welyvra/db",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@welyvra/source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@welyvra/source": "./src/testing.ts",
      "types": "./src/testing.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -R src/migrations dist/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node dist/cli-migrate.js"
  },
  "dependencies": {
    "@welyvra/core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.8"
  }
}
