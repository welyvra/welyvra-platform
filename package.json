{
  "name": "welyvra-platform",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && vitest run",
    "build": "pnpm -r --if-present build",
    "research:p30": "node scripts/research/p30-events.ts",
    "demo": "pnpm build && node scripts/demo/demo.ts",
    "demo:live": "pnpm build && node scripts/demo/demo.ts --live",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.62.1",
    "@stellar/stellar-sdk": "17.4.0",
    "@types/node": "^24.19.2",
    "@welyvra/api": "workspace:*",
    "@welyvra/core": "workspace:*",
    "@welyvra/db": "workspace:*",
    "@welyvra/ingestion": "workspace:*",
    "@welyvra/reconciliation": "workspace:*",
    "@welyvra/stellar": "workspace:*",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "postgres": "3.4.8",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=7 <11.0.1": "^11.0.1"
    }
  },
  "type": "module"
}
